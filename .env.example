# =====================================================================
#  متغيّرات بيئة منصة فيش — انسخه إلى .env (لا ترفع القيم الحقيقية)
# =====================================================================

APP_BASE_URL=
PORT=3000

# Composio — الربط
COMPOSIO_API_KEY=
# Gemini — الوكلاء
GEMINI_API_KEY=

# Firebase (الواجهة)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# قاعدة البيانات (Supabase) — تخزين دائم وآمن للمفاتيح
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# أمان المفاتيح
# مفتاح تشفير 32 بايت (base64). اتركه فارغًا ليُنشأ في data/.fysh-store-key
FYSH_ENCRYPTION_KEY=
FYSH_MAX_KEYS_PER_USER=10
# اجعله true في الإنتاج لمنع إنشاء مفاتيح بدون تسجيل دخول
FYSH_REQUIRE_AUTH_FOR_KEYS=false
FIREBASE_PROJECT_ID=fysh-7f8ea
