# ------------------------------------------------------------------
# متغيّرات بيئة منصة فيش (انسخ هذا الملف إلى .env أو .env.local)
# لا ترفع أي ملف يحتوي قيمًا حقيقية إلى المستودع.
# ------------------------------------------------------------------

# [مطلوب] مفتاح مشروع Composio — من https://dashboard.composio.dev (Settings → API Keys)
COMPOSIO_API_KEY=

# [مطلوب لميزات الوكلاء] مفتاح Google Gemini — من https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [اختياري] الرابط العام للمنصة، يُستخدم في روابط العودة بعد الربط (OAuth callback)
# مثال: https://fysh.example.com   — اتركه فارغًا ليُستنتج من رأس الطلب
APP_BASE_URL=

# [اختياري] منفذ السيرفر (افتراضيًا 3000)
PORT=3000

# [اختياري] إعدادات Firebase للواجهة (من Firebase Console → Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
